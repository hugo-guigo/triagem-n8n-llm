# Copie para .env (ou rode: python scripts/gerar_env.py) e troque os valores.
# O .env nunca vai para o Git.

POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=troque-esta-senha
N8N_DB_PASSWORD=troque-esta-senha
APP_DB_PASSWORD=troque-esta-senha

# Chave que criptografa as credenciais salvas no n8n. Se perder, perde as credenciais.
N8N_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria

# Chave do Groq (console.groq.com, plano grátis). Opcional aqui: o configurar_n8n.py cria a
# credencial "Groq API" com ela. Sem a chave, crie a credencial na interface do n8n.
GROQ_API_KEY=
