{
  "id": "TriagemMsgs00001",
  "name": "Triagem de mensagens",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "triagem",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b7f8a51-1c2e-4a4b-9d10-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5f3c2a10-7d4e-4b8a-9c21-7a1e0b9d2f01"
    },
    {
      "parameters": {
        "jsCode": "// Valida o corpo do POST antes de gastar uma chamada de LLM.\n// Saída: { valido, erros[], mensagem{} } com os campos já limpos (trim).\nconst LIMITES = { id_mensagem: 64, nome: 100, canal: 20, texto: 2000 };\n\nconst body = $input.first().json.body;\nif (body === null || typeof body !== 'object' || Array.isArray(body)) {\n  return [{ json: { valido: false, erros: ['o corpo precisa ser um objeto JSON'] } }];\n}\n\nconst campo = (nome) => (typeof body[nome] === 'string' ? body[nome].trim() : '');\nconst erros = [];\n\nfor (const [nome, max] of Object.entries(LIMITES)) {\n  const valor = campo(nome);\n  if (!valor) erros.push(`campo obrigatório ausente ou vazio: ${nome}`);\n  else if (valor.length > max) erros.push(`${nome} passa de ${max} caracteres`);\n}\n\n// o id vira chave única no banco, então aceita só um formato previsível\nif (campo('id_mensagem') && !/^[A-Za-z0-9_-]+$/.test(campo('id_mensagem'))) {\n  erros.push('id_mensagem aceita só letras, números, _ e -');\n}\n\nreturn [{\n  json: {\n    valido: erros.length === 0,\n    erros,\n    mensagem: {\n      id_mensagem: campo('id_mensagem'),\n      nome: campo('nome'),\n      canal: campo('canal').toLowerCase(),\n      texto: campo('texto'),\n    },\n  },\n}];\n"
      },
      "id": "0b7f8a51-1c2e-4a4b-9d10-000000000002",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
